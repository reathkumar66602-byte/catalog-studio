# Copy to regression/.env and fill in. Never commit .env.

# Optional overrides (defaults are fine for most runs)
# PROD_BASE_URL=https://www.catalogstudio.in
# PROD_DASHBOARD_URL=https://www.catalogstudio.in
# STAGING_BASE_URL=https://staging.catalogstudio.in
# STAGING_DASHBOARD_URL=https://staging.catalogstudio.in

# Shared test seller (used for local/staging if specific keys unset)
TEST_EMAIL=seller@catalogstudio.local
TEST_PASSWORD=Seller@CatalogStudio1

# Dedicated prod regression account (read-only checks only)
# Create a real seller with active plan; do NOT use your personal admin password here.
PROD_TEST_EMAIL=
PROD_TEST_PASSWORD=

# Staging credentials
STAGING_TEST_EMAIL=
STAGING_TEST_PASSWORD=
