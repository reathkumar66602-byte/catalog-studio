# Copy to a local .env or set these in your IDE run configuration.
SPRING_PROFILES_ACTIVE=dev
DATABASE_URL=jdbc:postgresql://localhost:5432/catalog_studio
DATABASE_USER=postgres
DATABASE_PASSWORD=root
JWT_SECRET=change-this-to-a-256-bit-secret-key-for-catalog-studio
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
MAIL_ENABLED=true
MAIL_PROVIDER=zoho
ZOHO_MAIL_HOST=smtp.zoho.in
ZOHO_MAIL_PORT=587
ZOHO_MAIL_USERNAME=
ZOHO_MAIL_PASSWORD=
ZOHO_MAIL_FROM=support@catalogstudio.in
ZOHO_MAIL_FROM_NAME=Catalog Studio
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_SEND_TOKEN=
OTP_ENABLED=true
OTP_LOG_CODE=false
GOOGLE_MAPS_API_KEY=

# GCP cloud cost dashboard (superadmin). Uses Application Default Credentials.
# Prefer a dedicated SA JSON (never commit it). Example path after generating the key:
# GOOGLE_APPLICATION_CREDENTIALS=./secrets/cloud-cost-reader.json
# Or: gcloud auth application-default login
CLOUD_COST_ENABLED=true
CLOUD_COST_BILLING_ACCOUNT_ID=012AA3-8490F8-BDB5E6
CLOUD_COST_ANNUAL_BUDGET_INR=30000
CLOUD_COST_QUOTA_PROJECT_ID=catalog-studio-prod
CLOUD_COST_BQ_ENABLED=true
CLOUD_COST_BQ_PROJECT_ID=catalog-studio-prod
CLOUD_COST_BQ_DATASET_ID=gcp_billing_export
CLOUD_COST_BQ_TABLE_ID=gcp_billing_export_resource_v1_012AA3_8490F8_BDB5E6

# Wholesale marketplace (Live Stock) - GST verification via gstinapi.in
# mock = local/dev | gstinapi = production | http = generic fallback
WHOLESALE_GST_PROVIDER=mock
WHOLESALE_GST_NAME_MATCH_THRESHOLD=0.72
GSTINAPI_BASE_URL=https://www.gstinapi.in
GSTINAPI_API_KEY=
WHOLESALE_GST_HTTP_URL=
WHOLESALE_GST_HTTP_API_KEY=

# Cashfree Payment Gateway (never commit real secrets)
CASHFREE_ENABLED=true
CASHFREE_ENV=PROD
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
