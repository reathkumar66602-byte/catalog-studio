{
  "manifest_version": 3,
  "name": "Catalog Studio Autofill",
  "version": "1.4.2",
  "description": "Detect the Meesho store, generate listing details from the product photo, and fill the catalog form. Never auto-submits.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Catalog Studio — click to open the sidebar",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "popup.html",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://supplier.meesho.com/*",
    "https://www.meesho.com/*",
    "https://meesho.com/*",
    "https://images.meesho.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://supplier.meesho.com/*"],
      "js": ["awake.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://supplier.meesho.com/*"],
      "js": ["content.js", "imgsync.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.meesho.com/*", "https://meesho.com/*"],
      "js": ["scout.js"],
      "css": ["scout.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["pair.js"],
      "run_at": "document_idle"
    }
  ]
}
