# Copy to .env and fill secrets. Do not commit a filled copy.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/catalog_studio
DATABASE_USER=postgres
DATABASE_PASSWORD=root

JWT_SECRET=change-this-to-a-256-bit-secret-key-for-catalog-studio
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/api/v1/files

SEED_ADMIN_EMAIL=admin@catalogstudio.local
SEED_ADMIN_PASSWORD=Admin@CatalogStudio1
SEED_SELLER_EMAIL=seller@catalogstudio.local
SEED_SELLER_PASSWORD=Seller@CatalogStudio1

VITE_API_URL=http://localhost:8080/api/v1

MAIL_ENABLED=true
MAIL_PROVIDER=zoho
# Gmail mailbox: use smtp.gmail.com and a Google App Password.
# Zoho mailbox: use smtp.zoho.in and the Zoho address (not a Gmail From).
ZOHO_MAIL_HOST=smtp.zoho.in
ZOHO_MAIL_PORT=587
ZOHO_MAIL_USERNAME=support@catalogstudio.in
ZOHO_MAIL_PASSWORD=
ZOHO_MAIL_FROM=support@catalogstudio.in
ZOHO_MAIL_FROM_NAME=Catalog Studio
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_SEND_TOKEN=
OTP_ENABLED=true
OTP_TTL_MINUTES=10
OTP_LOG_CODE=false

GOOGLE_MAPS_API_KEY=
