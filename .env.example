# Copy to .env and fill secrets. Do not commit a filled copy.

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

DATABASE_URL=jdbc:postgresql://localhost:5432/catalog_studio
DATABASE_USER=postgres
DATABASE_PASSWORD=root

JWT_SECRET=change-this-to-a-256-bit-secret-key-for-catalog-studio
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Local can stay mock. Production (.env.gcp) must be openai with a real AI_API_KEY.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/api/v1/files

SEED_ADMIN_EMAIL=admin@catalogstudio.local
SEED_ADMIN_PASSWORD=Admin@CatalogStudio1
SEED_SELLER_EMAIL=seller@catalogstudio.local
SEED_SELLER_PASSWORD=Seller@CatalogStudio1

VITE_API_URL=http://localhost:8080/api/v1

MAIL_ENABLED=true
MAIL_PROVIDER=zoho
# Gmail mailbox: use smtp.gmail.com and a Google App Password.
# Zoho mailbox: use smtp.zoho.in and the Zoho address (not a Gmail From).
ZOHO_MAIL_HOST=smtp.zoho.in
ZOHO_MAIL_PORT=587
ZOHO_MAIL_USERNAME=support@catalogstudio.in
ZOHO_MAIL_PASSWORD=
ZOHO_MAIL_FROM=support@catalogstudio.in
ZOHO_MAIL_FROM_NAME=Catalog Studio
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
ZEPTOMAIL_SEND_TOKEN=
OTP_ENABLED=true
OTP_TTL_MINUTES=10
OTP_LOG_CODE=false

GOOGLE_MAPS_API_KEY=

# Tingily (Meesho trending). Use the Pro account email/password.
TINGILY_BASE_URL=https://engine1.tingily.com
TINGILY_EMAIL=
TINGILY_PASSWORD=
TINGILY_TOKEN=
TINGILY_FETCH_LIMIT=40

# Platform OMS (Base.com-style) — credentials in this file only (not UI paste).
# Flipkart Self Access
FLIPKART_OMS_ENABLED=false
FLIPKART_APP_ID=
FLIPKART_APP_SECRET=
FLIPKART_LOCATION_ID=

# Amazon SP-API (LWA)
AMAZON_OMS_ENABLED=false
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_LWA_REFRESH_TOKEN=
AMAZON_MARKETPLACE_ID=A21TJRUUN4KGV
AMAZON_SP_API_SANDBOX=true

# Meesho Supplier Panel
MEESHO_OMS_ENABLED=false
MEESHO_PANEL_EMAIL=
MEESHO_PANEL_PASSWORD=
MEESHO_PANEL_BASE_URL=https://supplier.meesho.com
MEESHO_PANEL_LIVE_AUTH_REQUIRED=false

# Couriers beyond marketplace labels
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
DELHIVERY_API_TOKEN=

# Wholesale marketplace (Live Stock) - GST verification via gstinapi.in
# mock = local/dev | gstinapi = production | http = generic fallback
WHOLESALE_GST_PROVIDER=mock
WHOLESALE_GST_NAME_MATCH_THRESHOLD=0.72
GSTINAPI_BASE_URL=https://www.gstinapi.in
GSTINAPI_API_KEY=
# Optional generic HTTP provider (only when WHOLESALE_GST_PROVIDER=http)
WHOLESALE_GST_HTTP_URL=
WHOLESALE_GST_HTTP_API_KEY=
